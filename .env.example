# Copy to .env.local (ignored by git) for local builds.
# No secrets belong here: Vite bakes VITE_* values into the public bundle.
#
# PLACEHOLDER: replace it with the real Worker URL (DEPLOY.md step d) before any release build.
# `npm run check:release` fails when the placeholder is found in the build.
VITE_WORKER_URL=https://your-worker.workers.dev
VITE_APP_VERSION=v0
